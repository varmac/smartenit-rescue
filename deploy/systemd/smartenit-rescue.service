[Unit]
Description=Smartenit Rescue MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=smartenit-rescue
Group=smartenit-rescue
ExecStart=/usr/local/bin/smartenit-rescue run --config /etc/smartenit-rescue/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=smartenit-rescue
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
